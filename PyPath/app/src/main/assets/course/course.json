          "steps": [
            "learn",
            "quiz"
          ]
        },
        {
          "id": "l3s2",
          "code": "3.2",
          "title": "while loops",
          "summary": "Repeat until a condition changes.",
          "steps": [
            "learn",
            "quiz"
          ]
        },
        {
          "id": "l3s3",
          "code": "3.3",
          "title": "break and continue",
